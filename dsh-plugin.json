{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "sleep-plugin-dsh",
  "name": "sleep-plugin-dsh",
  "version": "0.2.0",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "sleep-plugin-dsh.sleep",
      "reason": "Lets the user list or cancel native waits with /sleep."
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "sleep-plugin-dsh.sleep",
        "title": "Sleep",
        "description": "List or cancel native sleeps and timeouts of this session"
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT"
}
